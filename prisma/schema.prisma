generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String
  password             String
  role                 Role               @default(ALUNO)
  avatar               String?
  telefone             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  resetToken           String?            @db.Text
  resetTokenExpiry     DateTime?
  anotacoes            String?            @db.Text
  alunoProfile         AlunoProfile?
  assinatura           Assinatura?
  atribuicoes          AtribuicaoTreino[]
  avaliacoes           Avaliacao[]        @relation("AvaliacoesAluno")
  avaliacoesRealizadas Avaliacao[]        @relation("AvaliacoesTreinador")
  mensagensRecebidas   Mensagem[]         @relation("MensagensRecebidas")
  mensagensEnviadas    Mensagem[]         @relation("MensagensEnviadas")
  notificacoes         Notificacao[]
  treinosCriados       Treino[]           @relation("TreinosDoTreinador")
  treinoLogs           TreinoLog[]
}

model AlunoProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  dataNascimento      DateTime
  genero              String
  altura              Float
  pesoInicial         Float
  objetivos           String   @db.LongText
  restricoes          String?
  historicoSaude      String?
  nivelAtividade      String
  
  // Novos campos do Excel (Menu.csv)
  doresIntensidade    String?  @db.Text
  limitacoes          String?  @db.Text
  referenciaObjetivo  String?  @db.Text
  pontosFracos        String?  @db.Text
  pontosFortes        String?  @db.Text
  exerciciosProibidos String?  @db.Text
  metodosUtilizados   String?  @db.LongText
  rotina              String?  @db.LongText

  onboardingCompleto  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assinatura {
  id         String           @id @default(cuid())
  userId     String           @unique
  planoId    String
  status     StatusAssinatura @default(ATIVA)
  dataInicio DateTime         @default(now())
  dataFim    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  plano      Plano            @relation(fields: [planoId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([planoId], map: "Assinatura_planoId_fkey")
}

model Plano {
  id            String       @id @default(cuid())
  nome          String
  descricao     String?
  preco         Float
  intervalo     String
  recursos      String       @db.LongText
  ativo         Boolean      @default(true)
  destaque      Boolean      @default(false)
  textoDestaque String?
  desconto      String?
  gradiente     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assinaturas   Assinatura[]
}

model Pagamento {
  id              String     @id @default(cuid())
  assinaturaId    String
  valor           Float
  status          String
  metodoPagamento String
  transacaoId     String?
  preferenceId    String?
  createdAt       DateTime   @default(now())
  assinatura      Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([assinaturaId], map: "Pagamento_assinaturaId_fkey")
}

model Exercicio {
  id               String            @id @default(cuid())
  nome             String
  descricao        String?           @db.Text
  grupoMuscular    String            @db.LongText
  equipamento      String            @db.LongText
  videoUrl         String?
  gifUrl           String?
  instrucoes       String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  exerciciosTreino ExercicioTreino[]
}

model Treino {
  id          String             @id @default(cuid())
  nome        String
  descricao   String?            @db.Text
  tipo        String
  treinadorId String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  atribuicoes AtribuicaoTreino[]
  exercicios  ExercicioTreino[]
  treinador   User               @relation("TreinosDoTreinador", fields: [treinadorId], references: [id])

  @@index([treinadorId])
}

model ExercicioTreino {
  id          String         @id @default(cuid())
  treinoId    String
  exercicioId String
  ordem       Int
  series      Int
  repeticoes  String
  descanso    Int
  observacoes String?        @db.Text
  logs        ExercicioLog[]
  exercicio   Exercicio      @relation(fields: [exercicioId], references: [id])
  treino      Treino         @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([treinoId, ordem])
  @@index([exercicioId], map: "ExercicioTreino_exercicioId_fkey")
}

model AtribuicaoTreino {
  id         String   @id @default(cuid())
  treinoId   String
  alunoId    String
  diasSemana String   @db.LongText
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  aluno      User     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  treino     Treino   @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([treinoId, alunoId])
  @@index([alunoId], map: "AtribuicaoTreino_alunoId_fkey")
}

model TreinoLog {
  id         String         @id @default(cuid())
  alunoId    String
  treinoId   String
  treinoNome String
  dataInicio DateTime       @default(now())
  dataFim    DateTime?
  completo   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  exercicios ExercicioLog[]
  aluno      User           @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId], map: "TreinoLog_alunoId_fkey")
}

model ExercicioLog {
  id                String          @id @default(cuid())
  treinoLogId       String
  exercicioTreinoId String
  exercicioNome     String
  carga             Float?
  repeticoes        Int?
  rpe               Int?
  notas             String?         @db.Text
  concluido         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  exercicioTreino   ExercicioTreino @relation(fields: [exercicioTreinoId], references: [id])
  treinoLog         TreinoLog       @relation(fields: [treinoLogId], references: [id], onDelete: Cascade)

  @@index([exercicioTreinoId], map: "ExercicioLog_exercicioTreinoId_fkey")
  @@index([treinoLogId], map: "ExercicioLog_treinoLogId_fkey")
}

model Avaliacao {
  id                String          @id @default(cuid())
  alunoId           String
  treinadorId       String
  tipo              String
  data              DateTime        @default(now())
  peso              Float?
  bioimpedancia     String?         @db.LongText
  dobrasCutaneas    String?         @db.LongText
  perimetros        String?         @db.LongText
  mobilidade        String?         @db.LongText
  encurtamentos     String?         @db.LongText
  postura           String?         @db.LongText
  assimetrias       String?         @db.LongText
  cooperTest        Float?
  forcaMaxima       String?         @db.LongText
  potenciaIso       String?         @db.LongText
  percentualGordura Float?
  vo2Max            Float?
  percentVO2        Float?
  mets              Float?
  gastoCalorico     Float?
  observacoes       String?         @db.Text
  createdAt         DateTime        @default(now())
  aluno             User            @relation("AvaliacoesAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  treinador         User            @relation("AvaliacoesTreinador", fields: [treinadorId], references: [id])
  fotos             FotoAvaliacao[]

  @@index([alunoId, data])
  @@index([treinadorId])
}

model FotoAvaliacao {
  id          String    @id @default(cuid())
  avaliacaoId String
  url         String
  tipo        String
  createdAt   DateTime  @default(now())
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@index([avaliacaoId], map: "FotoAvaliacao_avaliacaoId_fkey")
}

model Mensagem {
  id             String   @id @default(cuid())
  remetenteId    String
  destinatarioId String
  conteudo       String   @db.Text
  anexoUrl       String?
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())
  destinatario   User     @relation("MensagensRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  remetente      User     @relation("MensagensEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)

  @@index([remetenteId, destinatarioId])
  @@index([destinatarioId, lida])
}

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  titulo    String
  mensagem  String   @db.Text
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
}

enum Role {
  ALUNO
  TREINADOR
  ADMIN
}

enum StatusAssinatura {
  ATIVA
  CANCELADA
  SUSPENSA
  EXPIRADA
}
