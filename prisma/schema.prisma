generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String?            @unique
  name                 String
  password             String?
  externalSourceId     String?            // Identificador técnico de importação
  role                 Role               @default(ALUNO)
  avatar               String?
  telefone             String?
  
  // Relacionamento multi-tenant: Um aluno pertence a um treinador
  treinadorId          String?
  treinador            User?              @relation("TreinadorAlunos", fields: [treinadorId], references: [id])
  alunos               User[]             @relation("TreinadorAlunos")

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  resetToken           String?
  resetTokenExpiry     DateTime?
  anotacoes            String?
  alunoProfile         AlunoProfile?
  assinaturas          Assinatura[]
  atribuicoes          AtribuicaoTreino[]
  avaliacoes           Avaliacao[]        @relation("AvaliacoesAluno")
  avaliacoesRealizadas Avaliacao[]        @relation("AvaliacoesTreinador")
  mensagensRecebidas   Mensagem[]         @relation("MensagensRecebidas")
  mensagensEnviadas    Mensagem[]         @relation("MensagensEnviadas")
  notificacoes         Notificacao[]
  treinosCriados       Treino[]           @relation("TreinosDoTreinador")
  treinoLogs           TreinoLog[]

  @@index([treinadorId])
}

model AlunoProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  dataNascimento      DateTime
  genero              String
  altura              Float
  pesoInicial         Float
  objetivos           String
  restricoes          String?
  historicoSaude      String?
  nivelAtividade      String
  
  // Novos campos do Excel (Menu.csv)
  doresIntensidade    String?
  limitacoes          String?
  referenciaObjetivo  String?
  pontosFracos        String?
  pontosFortes        String?
  exerciciosProibidos String?
  metodosUtilizados   String?
  rotina              String?

  onboardingCompleto  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assinatura {
  id         String           @id @default(cuid())
  userId     String
  treinadorId String
  planoId    String
  status     StatusAssinatura @default(ATIVA)
  dataInicio DateTime         @default(now())
  dataFim    DateTime?
  valor      Float            @default(0.0) // Trazido do plano no momento da assinatura
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  plano      Plano            @relation(fields: [planoId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([planoId])
  @@index([userId])
  @@index([treinadorId])
}

model Plano {
  id            String       @id @default(cuid())
  nome          String
  descricao     String?
  preco         Float
  intervalo     String
  recursos      String
  ativo         Boolean      @default(true)
  destaque      Boolean      @default(false)
  textoDestaque String?
  desconto      String?
  gradiente     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assinaturas   Assinatura[]
}

model Pagamento {
  id              String     @id @default(cuid())
  assinaturaId    String
  valor           Float
  status          String
  metodoPagamento String
  observacao      String?
  transacaoId     String?
  preferenceId    String?
  createdAt       DateTime   @default(now())
  assinatura      Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([assinaturaId])
}

model Exercicio {
  id               String            @id @default(cuid())
  nome             String
  descricao        String?
  grupoMuscular    String
  equipamento      String
  videoUrl         String?
  gifUrl           String?
  instrucoes       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  exerciciosTreino ExercicioTreino[]
}

model Treino {
  id          String             @id @default(cuid())
  nome        String
  descricao   String?
  tipo        String
  treinadorId String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  atribuicoes AtribuicaoTreino[]
  exercicios  ExercicioTreino[]
  treinador   User               @relation("TreinosDoTreinador", fields: [treinadorId], references: [id])

  @@index([treinadorId])
}

model ExercicioTreino {
  id          String         @id @default(cuid())
  treinoId    String
  exercicioId String
  ordem       Int
  series      Int
  repeticoes  String
  descanso    Int
  observacoes String?
  logs        ExercicioLog[]
  exercicio   Exercicio      @relation(fields: [exercicioId], references: [id])
  treino      Treino         @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([treinoId, ordem])
  @@index([exercicioId])
}

model AtribuicaoTreino {
  id         String   @id @default(cuid())
  treinoId   String
  alunoId    String
  diasSemana String
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  aluno      User     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  treino     Treino   @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([treinoId, alunoId])
  @@index([alunoId])
}

model TreinoLog {
  id         String         @id @default(cuid())
  alunoId    String
  treinadorId String
  treinoId   String
  treinoNome String
  dataInicio DateTime       @default(now())
  dataFim    DateTime?
  completo   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  exercicios ExercicioLog[]
  aluno      User           @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([treinadorId])
}

model ExercicioLog {
  id                String          @id @default(cuid())
  treinoLogId       String
  exercicioTreinoId String
  exercicioNome     String
  carga             Float?
  repeticoes        Int?
  rpe               Int?
  notas             String?
  concluido         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  exercicioTreino   ExercicioTreino @relation(fields: [exercicioTreinoId], references: [id])
  treinoLog         TreinoLog       @relation(fields: [treinoLogId], references: [id], onDelete: Cascade)

  @@index([exercicioTreinoId])
  @@index([treinoLogId])
}

model Avaliacao {
  id                String          @id @default(cuid())
  alunoId           String
  treinadorId       String
  tipo              String
  data              DateTime        @default(now())
  peso              Float?
  bioimpedancia     String?
  dobrasCutaneas    String?
  perimetros        String?
  mobilidade        String?
  encurtamentos     String?
  postura           String?
  assimetrias       String?
  cooperTest        Float?
  forcaMaxima       String?
  potenciaIso       String?
  percentualGordura Float?
  vo2Max            Float?
  percentVO2        Float?
  mets              Float?
  gastoCalorico     Float?
  observacoes       String?
  sourceHash        String?         // Hash de auditoria de duplicidade
  createdAt         DateTime        @default(now())
  aluno             User            @relation("AvaliacoesAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  treinador         User            @relation("AvaliacoesTreinador", fields: [treinadorId], references: [id])
  fotos             FotoAvaliacao[]

  @@index([alunoId, data])
  @@index([treinadorId])
}

model FotoAvaliacao {
  id          String    @id @default(cuid())
  avaliacaoId String
  url         String
  tipo        String
  createdAt   DateTime  @default(now())
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@index([avaliacaoId])
}

model Mensagem {
  id             String   @id @default(cuid())
  remetenteId    String
  destinatarioId String
  conteudo       String
  anexoUrl       String?
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())
  destinatario   User     @relation("MensagensRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  remetente      User     @relation("MensagensEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)

  @@index([remetenteId, destinatarioId])
  @@index([destinatarioId, lida])
}

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
}

model ImportBatch {
  id                  String   @id @default(cuid())
  treinadorId         String
  dataImportacao      DateTime @default(now())
  arquivoOriginal     String
  hash                String?
  tamanho             Int?
  modo                String?
  userIdExecutor      String?
  registrosLidos      Int      @default(0)
  registrosImportados Int      @default(0)
  registrosRejeitados Int      @default(0)
  registrosDuplicados Int      @default(0)
  errosDetalhes       String?  
  status              String   @default("SUCESSO") // SIMULATED, SUCESSO, PARCIAL, FALHA, REVERTIDO
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())

  @@index([treinadorId])
}

enum Role {
  ALUNO
  TREINADOR
  ADMIN
}

enum StatusAssinatura {
  ATIVA
  CANCELADA
  SUSPENSA
  EXPIRADA
}
